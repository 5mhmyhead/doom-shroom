{
  "expo": {
    "name": "doom-shroom",
    "slug": "doom-shroom",
    "version": "1.0.0",
    "scheme": "doomshroom",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.doomshroom"
    },
    "plugins": [
      "expo-app-blocker",
      "./plugins/translucent.js"
    ]
  }
}